{
  "info": {
    "name": "DevTrack API",
    "description": "Covers reporter and issue CRUD reads, validation, referential integrity, duplicate IDs, filters, and method handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Reporter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/api/reporters/",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "8000",
          "path": [
            "api",
            "reporters"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"name\": \"Alice Example\",\n  \"email\": \"alice@example.com\",\n  \"team\": \"backend\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('reporter fields are returned', function () { pm.expect(body.name).to.eql('Alice Example'); pm.expect(body.team).to.eql('backend'); });"
            ]
          }
        }
      ]
    },
